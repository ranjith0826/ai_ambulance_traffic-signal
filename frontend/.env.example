# LifeLane AI Frontend Environment Configuration
VITE_API_BASE=http://localhost:8000
VITE_SOCKET_URL=http://localhost:8000

# Map Provider API Keys (Optional - CartoDB Voyager and OSM work out-of-the-box)
# Mapbox: Get token from https://account.mapbox.com/
VITE_MAPBOX_TOKEN=

# Google Maps API Key: Get key from https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=

# MapTiler API Key: Get key from https://cloud.maptiler.com/
VITE_MAPTILER_KEY=

# OpenRouteService API Key for Routing: https://openrouteservice.org/
VITE_OPENROUTESERVICE_KEY=

# Google Gemini API Key for Clinical Triage & AI Copilot: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Map Layer Theme Default: 'voyager' | 'mapbox_streets' | 'mapbox_dark' | 'osm' | 'google_hybrid'
VITE_DEFAULT_MAP_THEME=voyager
